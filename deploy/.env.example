# Server settings for deploy/compose.yml. setup.sh creates deploy/.env from this file with random secrets,
# so you normally only edit the hosts (if you have your own domain) and the payment keys. Never commit .env.
# إعدادات السيرفر لـ deploy/compose.yml. setup.sh ينشئ deploy/.env من هذا الملف بأسرار عشوائية،
# فعادةً تعدّل بس العناوين (لو عندك دومين خاص) ومفاتيح الدفع. لا ترفع .env أبدًا.

# Which apps to run (comma separated). / أي تطبيقات تشتغل (مفصولة بفواصل).
COMPOSE_PROFILES=masar,stockmate,clientflow

# Public addresses. Without a domain, setup.sh uses free sslip.io names built from the server IP,
# e.g. masar.203-0-113-7.sslip.io. With a domain, point an A record to the server IP and put the name here.
# العناوين العامة. بدون دومين، setup.sh يستخدم أسماء sslip.io مجانية مبنية من IP السيرفر،
# مثل masar.203-0-113-7.sslip.io. ومع دومين، وجّه سجل A لـ IP السيرفر واكتب الاسم هنا.
MASAR_HOST=
STOCKMATE_HOST=
CLIENTFLOW_HOST=

# Secrets: filled with random values by setup.sh. / أسرار: setup.sh يعبيها بقيم عشوائية.
MASAR_JWT_SECRET=
STOCKMATE_JWT_SECRET=
CLIENTFLOW_JWT_SECRET=
MASAR_DB_PASSWORD=
STOCKMATE_DB_PASSWORD=
CLIENTFLOW_DB_PASSWORD=

# Demo data, so visitors and employers can try every role. The admin password is private (random, only you know it);
# the staff and customer passwords are the public demo ones from each README.
# بيانات تجريبية حتى الزوار وأصحاب العمل يجربون كل الأدوار. كلمة مرور المدير خاصة (عشوائية، تعرفها أنت بس)؛
# وكلمات مرور الموظفين والعملاء هي التجريبية المنشورة في كل README.
SEED_DEMO_DATA=true
ADMIN_PASSWORD=
STAFF_PASSWORD=Staff@12345
CUSTOMER_PASSWORD=Customer@12345
SALES_PASSWORD=Sales@12345
CLIENT_PASSWORD=Client@12345

# Every night at 03:00 Riyadh time, wipe each app's data and reload the demo data, so the public demo stays clean.
# Set to false once real users keep real data. / كل ليلة الساعة 3 الفجر بتوقيت الرياض، تنمسح بيانات كل تطبيق وترجع
# البيانات التجريبية، فيبقى العرض نظيف. خلّها false لو صار فيه مستخدمين حقيقيين ببيانات حقيقية.
DEMO_RESET=true
# Every night, pull the newest images CI published and restart only what changed.
# كل ليلة، يسحب أحدث صور نشرها CI ويعيد تشغيل اللي تغيّر بس.
AUTO_UPDATE=true

# Pin an exact version (a commit SHA tag from ghcr.io) to roll back; "latest" follows main.
# ثبّت نسخة محددة (تاج SHA من ghcr.io) للرجوع لها؛ و"latest" يتبع main.
MASAR_TAG=latest
STOCKMATE_TAG=latest
CLIENTFLOW_TAG=latest

# ----- Payments / المدفوعات -----
# SANDBOX is the built-in test gateway (no real money, works with no account). For MOYASAR or STRIPE, set the provider
# and its secret key. Use TEST keys for a portfolio. Tabby/Tamara use their sandbox API when a key is set.
# SANDBOX هي البوابة التجريبية المدمجة (بدون فلوس حقيقية ولا تحتاج حساب). لـ MOYASAR أو STRIPE حدد المزوّد ومفتاحه السري.
# استخدم مفاتيح TEST للمعرض. وتابي وتمارا يستخدمون API التجريبي حقهم لو انحط مفتاح.
MASAR_CARD_PAYMENT_PROVIDER=SANDBOX
MASAR_MOYASAR_SECRET_KEY=
MASAR_STRIPE_SECRET_KEY=
MASAR_TABBY_SECRET_KEY=
MASAR_TABBY_MERCHANT_CODE=
MASAR_TAMARA_API_TOKEN=

STOCKMATE_CARD_PAYMENT_PROVIDER=SANDBOX
STOCKMATE_MOYASAR_SECRET_KEY=
STOCKMATE_STRIPE_SECRET_KEY=
STOCKMATE_TABBY_SECRET_KEY=
STOCKMATE_TABBY_MERCHANT_CODE=
STOCKMATE_TAMARA_API_TOKEN=

CLIENTFLOW_CARD_PAYMENT_PROVIDER=SANDBOX
CLIENTFLOW_MOYASAR_SECRET_KEY=
CLIENTFLOW_STRIPE_SECRET_KEY=
CLIENTFLOW_TABBY_SECRET_KEY=
CLIENTFLOW_TABBY_MERCHANT_CODE=
CLIENTFLOW_TAMARA_API_TOKEN=
